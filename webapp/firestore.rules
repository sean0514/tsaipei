rules_version = '2';

// Two systems share this project, fully separated by collection name prefix
// (tsaipei_* / foodfactory_*), matching the ROLES/DEFAULT_PERMISSIONS model
// each system's original Apps Script backend used (see apps-script/Code.gs
// in each repo). 系統管理員 (admin) always has edit access, same as the
// hardcoded bypass in permFor_() there.
//
// Bootstrapping: the very first admin doc in `<system>_users` can't be
// created through these rules (nothing can grant edit before an admin
// exists) — create it once by hand in the Firebase console after the
// person signs up via Firebase Auth: collection `tsaipei_users` (or
// `foodfactory_users`), doc id = their Auth UID, fields
// { email, displayName, role: '系統管理員' }.
//
// Adding a new collection: add a `match /<system>_<name>/{docId}` block
// below with the right module key passed to `tsCanEdit`/`ffCanEdit` — the
// module key must match a key in src/lib/permissions.js SYSTEMS[system].modules,
// same easy-to-miss step as pageModuleKey() in the original apps (see HANDOFF.md).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---------------- 境外實習生管理系統 (tsaipei) ----------------
    function tsRole() {
      return get(/databases/$(database)/documents/tsaipei_users/$(request.auth.uid)).data.role;
    }
    function tsIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/tsaipei_users/$(request.auth.uid));
    }
    // 沒有人在「使用人員」頁面動過某個模組/角色的權限時，tsaipei_rolePermissions
    // 底下就不會有對應的 override 文件——這時要照 src/lib/permissions.js
    // SYSTEMS.tsaipei.defaultPermissions 的預設值判斷，不能直接當作沒有權限，
    // 否則前端（用預設值判斷）顯示看得到「編輯」，但這裡的規則卻擋掉寫入。
    function tsDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'edit','主管':'edit','業務人員':'view','服務人員':'view','翻譯人員':'view','國外供應':'view','行政人員':'view','會計人員':'view','財務人員':'view','宿管人員':'view'},
        'students': {'系統管理員':'edit','主管':'edit','業務人員':'view','服務人員':'edit','翻譯人員':'view','國外供應':'view','行政人員':'edit','會計人員':'view','財務人員':'view','宿管人員':'view'},
        'positions': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'view','翻譯人員':'none','國外供應':'none','行政人員':'view','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'matches': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'view','翻譯人員':'none','國外供應':'none','行政人員':'view','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'secondInterview': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'view','翻譯人員':'none','國外供應':'none','行政人員':'view','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'admitted': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'view','翻譯人員':'none','國外供應':'none','行政人員':'view','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'visaReminder': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'view','翻譯人員':'none','國外供應':'none','行政人員':'view','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'applicationProgress': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'inTaiwanVisa': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'edit'},
        'inTaiwanCare': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'edit'},
        'expectedArrival': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'edit'},
        'bankAccountProgress': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'edit'},
        'vehiclePickup': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'edit'},
        'internshipDocs': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'housing': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'edit'},
        'dormManagement': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'view','翻譯人員':'none','國外供應':'none','行政人員':'edit','會計人員':'view','財務人員':'view','宿管人員':'edit'},
        'meetings': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'view','會計人員':'view','財務人員':'view','宿管人員':'view'},
        'closedCases': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'foreignSubsidyApplication': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'dailyExpenseApplication': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'postageFee': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'clientBilling': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'studentSelfPayHousing': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'studentMasterSheet': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'foreignPayment': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'clientList': {'系統管理員':'edit','主管':'edit','業務人員':'edit','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'view','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'clientFeeSetup': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'internalFeeSetup': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'bonus': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'users': {'系統管理員':'edit','主管':'view','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'managerReport': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'adminPending': {'系統管理員':'edit','主管':'edit','業務人員':'view','服務人員':'edit','翻譯人員':'view','國外供應':'none','行政人員':'edit','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'studentBilling': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
        'companyProfitLoss': {'系統管理員':'edit','主管':'edit','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'edit','財務人員':'edit','宿管人員':'none'},
      }[module][role];
    }
    function tsCanEdit(module) {
      return tsIsMember() && (
        tsRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/tsaipei_rolePermissions/$(module + '__' + tsRole()))
          ? get(/databases/$(database)/documents/tsaipei_rolePermissions/$(module + '__' + tsRole())).data.level == 'edit'
          : tsDefaultLevel(module, tsRole()) == 'edit')
      );
    }

    match /tsaipei_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || tsIsMember());
      allow write: if tsIsMember() && tsRole() == '系統管理員';
    }
    match /tsaipei_rolePermissions/{docId} {
      allow read: if tsIsMember();
      allow write: if tsIsMember() && tsRole() == '系統管理員';
    }
    // create/update/delete 都額外放行 vnCanEdit('students')：越南系統新增
    // 學生時會自動同步建立一筆對應的 tsaipei_students 紀錄，之後在越南系統
    // 編輯/刪除該學生也會同步更新/刪除這筆紀錄（見 vietnam/StudentsPage.jsx）。
    // read 額外放行 vnIsMember()：元凱系統的媒合紀錄/二面進度/錄取名單/
    // 辦理簽證提醒/實習文件追蹤/申辦進度追蹤/在台簽證追蹤這幾個模組改成
    // 唯讀顯示境外生實習系統的資料（只篩選特定學生來源），需要讀這裡解析
    // 學生姓名/來源。
    match /tsaipei_students/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow create, delete: if tsCanEdit('students') || vnCanEdit('students');
      // update is also allowed to internshipDocs/inTaiwanVisa editors:
      // InternshipDocsPage syncs doc-status fields back onto the student
      // record, and InTaiwanVisaPage syncs entry/exit dates back the same
      // way the original apps-script backend's syncStudentDocField_/
      // syncStudentDatesFromVisa_ did. closedCases 也放行：「已結案名單」的
      // 復原按鈕要能把 confirmedClosed 改回 false。
      allow update: if tsCanEdit('students') || tsCanEdit('internshipDocs') || tsCanEdit('inTaiwanVisa') || tsCanEdit('closedCases') || vnCanEdit('students');
    }
    // 職缺媒合 group — 原本四個集合共用 'matching' 權限，依需求改成每個
    // 分頁各自独立（positions/matches/secondInterview/admitted/visaReminder）。
    // read 額外放行 vnIsMember()：「實習單位福利」頁面兩個系統互相顯示合併
    // 後的福利清單（境外生實習系統/越南實習生系統的使用者都要能讀到對方
    // 系統的實習單位資料），write 仍只限各自系統的編輯權限。
    match /tsaipei_positions/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow write: if tsCanEdit('positions');
    }
    match /tsaipei_matches/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      // create is also allowed to anyone who can edit 'students': new-student
      // save auto-creates a blank match record (see StudentsPage.jsx), and
      // some roles (服務人員/行政人員) can edit students without editing matches.
      allow create: if tsCanEdit('matches') || tsCanEdit('students') || vnCanEdit('students');
      allow update: if tsCanEdit('matches') || tsCanEdit('closedCases');
      // delete also allowed to 'students' editors: deleting a student
      // cascade-deletes their match records (see StudentsPage.jsx handleDelete,
      // mirroring deleteStudent() in apps-script/Code.gs). vnCanEdit('students')
      // 放行理由同上，越南系統同步刪除學生時也要能連鎖刪除這裡。
      allow delete: if tsCanEdit('matches') || tsCanEdit('students') || vnCanEdit('students');
    }
    match /tsaipei_secondInterviews/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow create: if tsCanEdit('secondInterview');
      allow update: if tsCanEdit('secondInterview') || tsCanEdit('closedCases');
      allow delete: if tsCanEdit('secondInterview') || tsCanEdit('students') || vnCanEdit('students');
    }
    match /tsaipei_admittedList/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow create: if tsCanEdit('admitted');
      // 申辦進度追蹤「學生錄取」日期異動會回寫這裡的錄取日期，所以 update
      // 也放行 applicationProgress（見 ApplicationProgressPage.jsx 的 syncAdmittedDate）；
      // closedCases 放行是為了「已結案名單」的復原按鈕。
      allow update: if tsCanEdit('admitted') || tsCanEdit('applicationProgress') || tsCanEdit('closedCases');
      allow delete: if tsCanEdit('admitted') || tsCanEdit('students') || vnCanEdit('students');
    }
    // 確認錄取 cascades into these two, written by whoever can edit 'admitted'
    // even if they can't edit these modules directly (same reasoning as
    // tsaipei_matches' create above).
    match /tsaipei_internshipDocs/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow create: if tsCanEdit('internshipDocs') || tsCanEdit('admitted');
      allow update: if tsCanEdit('internshipDocs');
      allow delete: if tsCanEdit('internshipDocs') || tsCanEdit('admitted') || tsCanEdit('students') || vnCanEdit('students');
    }
    match /tsaipei_applicationProgress/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow create: if tsCanEdit('applicationProgress') || tsCanEdit('admitted');
      allow update: if tsCanEdit('applicationProgress') || tsCanEdit('closedCases');
      allow delete: if tsCanEdit('applicationProgress') || tsCanEdit('students') || vnCanEdit('students');
    }
    // 申辦進度到「入台」時連鎖建立以下三個，寫入者是 applicationProgress 編輯者；
    // inTaiwanVisa 存檔時也會連鎖補建 inTaiwanCare/housingRecords（見
    // InTaiwanVisaPage.jsx afterVisaSave，對應原本的
    // ensureInTaiwanCareForStudent_/ensureHousingRecordForStudent_）。
    match /tsaipei_inTaiwanVisa/{docId} {
      allow read: if tsIsMember() || vnIsMember();
      allow create: if tsCanEdit('inTaiwanVisa') || tsCanEdit('applicationProgress');
      // update 也放行 expectedArrival：「預計入台/離台」可以直接在頁面上
      // 編輯體檢/送工/航班/付款等欄位，寫回同一筆在台簽證追蹤紀錄。
      allow update: if tsCanEdit('inTaiwanVisa') || tsCanEdit('expectedArrival');
      allow delete: if tsCanEdit('inTaiwanVisa') || tsCanEdit('students') || vnCanEdit('students');
    }
    match /tsaipei_inTaiwanCare/{docId} {
      allow read: if tsIsMember();
      allow create: if tsCanEdit('inTaiwanVisa') || tsCanEdit('applicationProgress');
      allow update: if tsCanEdit('inTaiwanCare');
      allow delete: if tsCanEdit('inTaiwanCare') || tsCanEdit('students') || vnCanEdit('students');
    }
    match /tsaipei_housingRecords/{docId} {
      allow read: if tsIsMember();
      allow create: if tsCanEdit('housing') || tsCanEdit('applicationProgress') || tsCanEdit('inTaiwanVisa');
      allow update: if tsCanEdit('housing');
      allow delete: if tsCanEdit('housing') || tsCanEdit('students') || vnCanEdit('students');
    }
    // 接送車輛安排：獨立集合，跟在台簽證追蹤只靠 visaId/visaLabel 做「待安排」
    // 清單去重，不是寫回同一筆紀錄，所以送工/送宿舍這種沒有對應入境/離境
    // 日期的安排也可以直接手動新增。
    match /tsaipei_vehicleArrangements/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('vehiclePickup');
    }
    // 開戶進度追蹤：一位學生一筆，勾選框第一次操作時才建立，所以 create/update 都放行。
    match /tsaipei_bankAccountProgress/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('bankAccountProgress');
    }
    match /tsaipei_dormitories/{docId} {
      allow read: if tsIsMember();
      allow create, delete: if tsCanEdit('dormManagement');
      // closedCases 也放行：「已結案名單」的復原按鈕要能把 confirmedClosed 改回 false。
      allow update: if tsCanEdit('dormManagement') || tsCanEdit('closedCases');
    }
    match /tsaipei_dormitoryUtilities/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('dormManagement');
    }
    // 行政未完成事項：自由新增的代辦事項清單，不綁定其他集合。
    match /tsaipei_adminTodos/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('adminPending');
    }
    // 聯絡資訊／各區翻譯資訊、各區宿管資訊：外部配合資源的聯絡清單。
    match /tsaipei_translatorContacts/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('translatorContacts');
    }
    match /tsaipei_dormManagerContacts/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('dormManagerContacts');
    }
    // 學生請款計算：每個學生每個月的已收款/收款日期記錄，其他金額欄位都是
    // 即時計算、不落地儲存。
    match /tsaipei_studentBillingPayments/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('studentBilling');
    }
    // 學生請款計算：確認封存的請款明細快照(每個住宿紀錄/月份一筆)，封存後
    // 畫面跟收款總帳都改用這份固定資料，不再即時重算。
    match /tsaipei_studentBillingLocks/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('studentBilling');
    }
    // 客戶請款計算：確認封存的請款紀錄快照(每個客戶/專案/月份一筆)，封存
    // 後畫面跟下載請款單都改用這份固定資料，不再即時重算。
    match /tsaipei_clientBillingLocks/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('clientBilling');
    }
    // 內部獎金計算：確認封存的獎金快照(每個月份一筆，含客戶/宿管兩份明細)，
    // 封存後畫面改用這份固定資料，不再即時重算。
    match /tsaipei_bonusArchives/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('bonus');
    }
    // 公司損益：使用者自行新增的收入/支出項目(例如內部人員薪資、保費)，
    // 項目本身不分年份，金額依項目+月份各存一筆。
    match /tsaipei_companyPnlCustomItems/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('companyProfitLoss');
    }
    match /tsaipei_companyPnlCustomAmounts/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('companyProfitLoss');
    }
    match /tsaipei_meetings/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('meetings');
    }
    // 申請表格：國外補助申請/日常支出申請/郵資費用紀錄原本共用
    // 'applicationForms' 權限，依需求改成每個分頁各自独立。
    match /tsaipei_foreignSubsidyApplications/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('foreignSubsidyApplication');
    }
    match /tsaipei_postageFeeRecords/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('postageFee');
    }
    // 已核准/已匯款之後，只有系統管理員/主管/會計人員能再改這筆申請（改狀態/
    // 編輯/刪除），避免核准過的紀錄被其他角色隨便改掉；新增紀錄不受此限制。
    match /tsaipei_dailyExpenseApplications/{docId} {
      allow read: if tsIsMember();
      allow create: if tsCanEdit('dailyExpenseApplication');
      allow update, delete: if tsCanEdit('dailyExpenseApplication') &&
        (!(resource.data.status in ['已核准', '已匯款']) || tsRole() in ['系統管理員', '主管', '會計人員']);
    }
    // 內部獎金計算/客戶費用建檔/內部費用建檔原本共用 'bonus' 權限，依需求
    // 改成每個分頁各自独立。
    match /tsaipei_internalFeeSetup/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('internalFeeSetup');
    }
    // create 額外放行 positions：新增實習單位時會自動在這裡帶入一筆空白費率，
    // 經辦人不一定有 clientFeeSetup 權限。
    match /tsaipei_clientFeeSetup/{docId} {
      allow read: if tsIsMember();
      allow create: if tsCanEdit('clientFeeSetup') || tsCanEdit('positions');
      allow update, delete: if tsCanEdit('clientFeeSetup');
    }
    // 客戶列表：客戶基本資料名冊（名稱/統一編號/產業別/收費類型/實習津貼/
    // 膳宿費扣款/其他福利），跟 clientFeeSetup 各自獨立。
    match /tsaipei_clientList/{docId} {
      allow read: if tsIsMember();
      allow write: if tsCanEdit('clientList');
    }
    // create/update 額外放行 foreignSubsidyApplication：國外補助申請核准
    // （或核准後又修改內容）時會自動在這裡帶入/同步一筆待付款紀錄，經辦人
    // 不一定有 foreignPayment 權限。delete 仍只限 foreignPayment，避免誤刪
    // 已維護的付款紀錄。
    match /tsaipei_foreignPayments/{docId} {
      allow read: if tsIsMember();
      allow create, update: if tsCanEdit('foreignPayment') || tsCanEdit('foreignSubsidyApplication');
      allow delete: if tsCanEdit('foreignPayment');
    }

    // ---------------- 越南實習生管理系統 (vietnam) ----------------
    // 複製 tsaipei 的權限模型(模組/預設權限完全一樣，見 src/lib/permissions.js
    // SYSTEMS.vietnam)，collection 字首改成 vietnam_。分頁依 tsaipei 的分批
    // 複製進度陸續補上對應的 match 區塊；還沒有專屬編輯頁的集合先開
    // 唯讀給系統成員，等該分頁複製過來時再補上對應的 vnCanEdit() 寫入規則。
    function vnRole() {
      return get(/databases/$(database)/documents/vietnam_users/$(request.auth.uid)).data.role;
    }
    function vnIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/vietnam_users/$(request.auth.uid));
    }
    function vnDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'students': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'positions': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'matches': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'secondInterview': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'admitted': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'visaReminder': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'visaProcessing': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'applicationProgress': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'inTaiwanCare': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'expectedArrival': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'departureTransport': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'bankAccountProgress': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'vehiclePickup': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'internshipDocs': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'housing': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'dormManagement': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'meetings': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'closedCases': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'studentSelfPayHousing': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'studentMasterSheet': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'dormProfitLoss': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'schoolSetup': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'internalBonusRateSetup': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'bonus': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'scholarships': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'users': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'managerReport': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'adminPending': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'studentBilling': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
        'resumeLinks': {'系統管理員':'edit','主管':'none','業務人員':'none','服務人員':'none','翻譯人員':'none','國外供應':'none','行政人員':'none','會計人員':'none','財務人員':'none','宿管人員':'none'},
      }[module][role];
    }
    function vnCanEdit(module) {
      return vnIsMember() && (
        vnRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/vietnam_rolePermissions/$(module + '__' + vnRole()))
          ? get(/databases/$(database)/documents/vietnam_rolePermissions/$(module + '__' + vnRole())).data.level == 'edit'
          : vnDefaultLevel(module, vnRole()) == 'edit')
      );
    }

    match /vietnam_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || vnIsMember());
      allow write: if vnIsMember() && vnRole() == '系統管理員';
    }
    match /vietnam_rolePermissions/{docId} {
      allow read: if vnIsMember();
      allow write: if vnIsMember() && vnRole() == '系統管理員';
    }
    match /vietnam_students/{docId} {
      allow read: if vnIsMember();
      // create 也放行 visaProcessing（越南端新增「越南辦理簽證」紀錄時）
      // 跟 tsCanEdit('applicationProgress')（境外生實習系統「申辦進度
      // 追蹤」自動連動建立越南簽證辦理紀錄時，是從 tsaipei 那邊的使用者
      // 觸發，要放行 tsaipei 系統自己的 applicationProgress 權限，不是
      // 越南系統的）：這兩種情況都會順便確保這裡也有一筆對應的學生資料
      // （見 lib/vietnamTsaipeiStudentSync.js 的 ensureVietnamStudentForTsaipeiStudent）。
      allow create: if vnCanEdit('students') || vnCanEdit('visaProcessing') || tsCanEdit('applicationProgress');
      allow delete: if vnCanEdit('students');
      // update 也放行 internshipDocs 編輯者：InternshipDocsPage 會把文件
      // 狀態同步回學生紀錄的對應欄位(syncStudentDocField)；closedCases 也
      // 放行：「已結案名單」的復原按鈕要能把 confirmedClosed 改回 false。
      allow update: if vnCanEdit('students') || vnCanEdit('internshipDocs') || vnCanEdit('closedCases');
    }
    match /vietnam_matches/{docId} {
      allow read: if vnIsMember();
      // create 也放行 students 編輯者：新增學生存檔會自動建立一筆空白媒合
      // 紀錄（見 StudentsPage.jsx），跟 tsaipei_matches 同樣的理由。
      allow create: if vnCanEdit('matches') || vnCanEdit('students');
      allow update: if vnCanEdit('matches') || vnCanEdit('closedCases');
      allow delete: if vnCanEdit('matches') || vnCanEdit('students');
    }
    // read 額外放行 tsIsMember()：理由同 tsaipei_positions 那邊的註解。
    match /vietnam_positions/{docId} {
      allow read: if vnIsMember() || tsIsMember();
      allow write: if vnCanEdit('positions');
    }
    match /vietnam_secondInterviews/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('secondInterview');
      allow update: if vnCanEdit('secondInterview') || vnCanEdit('closedCases');
      allow delete: if vnCanEdit('secondInterview') || vnCanEdit('students');
    }
    match /vietnam_admittedList/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('admitted');
      // closedCases 放行是為了「已結案名單」的復原按鈕。
      allow update: if vnCanEdit('admitted') || vnCanEdit('applicationProgress') || vnCanEdit('closedCases');
      allow delete: if vnCanEdit('admitted') || vnCanEdit('students');
    }
    // AdmittedListPage 狀態改成「確認錄取」時會連鎖建立 internshipDocs/
    // applicationProgress，所以這兩個集合的 create 也放行 admitted 編輯者，
    // 跟 tsaipei_internshipDocs/tsaipei_applicationProgress 同樣的理由。
    match /vietnam_internshipDocs/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('internshipDocs') || vnCanEdit('admitted');
      allow update: if vnCanEdit('internshipDocs');
      allow delete: if vnCanEdit('internshipDocs') || vnCanEdit('admitted') || vnCanEdit('students');
    }
    match /vietnam_applicationProgress/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('applicationProgress') || vnCanEdit('admitted');
      allow update: if vnCanEdit('applicationProgress') || vnCanEdit('closedCases');
      allow delete: if vnCanEdit('applicationProgress') || vnCanEdit('students');
    }
    match /vietnam_housingRecords/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('housing') || vnCanEdit('applicationProgress') || vnCanEdit('inTaiwanVisa');
      allow update: if vnCanEdit('housing');
      allow delete: if vnCanEdit('housing') || vnCanEdit('students');
    }
    match /vietnam_inTaiwanCare/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('inTaiwanVisa') || vnCanEdit('applicationProgress');
      allow update: if vnCanEdit('inTaiwanCare');
      allow delete: if vnCanEdit('inTaiwanCare') || vnCanEdit('students');
    }
    match /vietnam_inTaiwanVisa/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('inTaiwanVisa') || vnCanEdit('applicationProgress');
      // update 也放行 expectedArrival：「預計入台/離台」可以直接在頁面上
      // 編輯體檢/送工/航班/付款等欄位，寫回同一筆在台簽證追蹤紀錄。
      allow update: if vnCanEdit('inTaiwanVisa') || vnCanEdit('expectedArrival');
      allow delete: if vnCanEdit('inTaiwanVisa') || vnCanEdit('students');
    }
    match /vietnam_bankAccountProgress/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('bankAccountProgress');
    }
    match /vietnam_vehicleArrangements/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('vehiclePickup');
    }
    // 越南簽證辦理：境外生實習系統「申辦進度追蹤」的經濟部/交通部審核或
    // 發函後寄國外完成後會自動建立一筆「辦理中」紀錄，這個連動是從
    // tsaipei 那邊的使用者觸發的，所以 create 放行的是 tsCanEdit
    // (tsaipei 系統自己的 applicationProgress 權限)，不是 vnCanEdit
    // （那檢查的是越南系統自己的 applicationProgress 模組，跟這個連動
    // 無關，放錯會讓沒有越南系統帳號的 tsaipei 人員寫入被拒絕）。
    // delete 也放行 tsCanEdit('applicationProgress')：境外生實習系統刪除
    // 申辦進度紀錄時，會一併刪除連動建立的這筆越南簽證辦理紀錄（見
    // tsaipei/ApplicationProgressPage.jsx 的 handleDelete），是從 tsaipei
    // 那邊的使用者觸發，要放行 tsaipei 系統自己的權限。
    match /vietnam_visaProcessing/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('visaProcessing') || tsCanEdit('applicationProgress');
      allow update: if vnCanEdit('visaProcessing');
      allow delete: if vnCanEdit('visaProcessing') || tsCanEdit('applicationProgress');
    }
    // create 也放行 visaProcessing（越南端新增/補跑「越南辦理簽證」時，
    // 會順便在這裡建一筆空白送機行程紀錄）跟 tsCanEdit('applicationProgress')
    // （境外生實習系統「申辦進度追蹤」的連動也會觸發同一段邏輯，是從
    // tsaipei 那邊的使用者寫入，要放行 tsaipei 系統自己的權限）。
    match /vietnam_departureTransport/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('departureTransport') || vnCanEdit('visaProcessing') || tsCanEdit('applicationProgress');
      allow update, delete: if vnCanEdit('departureTransport');
    }
    // 申請表格：國外補助申請/日常支出申請/郵資費用紀錄每個分頁各自独立權限
    // （比照 tsaipei）。已核准/已匯款之後，只有系統管理員/主管/會計人員能
    // 再改日常支出申請的狀態/編輯/刪除。
    match /vietnam_dailyExpenseApplications/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('dailyExpenseApplication');
      allow update, delete: if vnCanEdit('dailyExpenseApplication') &&
        (!(resource.data.status in ['已核准', '已匯款']) || vnRole() in ['系統管理員', '主管', '會計人員']);
    }
    match /vietnam_foreignSubsidyApplications/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('foreignSubsidyApplication');
    }
    match /vietnam_dormitories/{docId} {
      allow read: if vnIsMember();
      allow create, delete: if vnCanEdit('dormManagement');
      // closedCases 也放行：「已結案名單」的復原按鈕要能把 confirmedClosed 改回 false。
      allow update: if vnCanEdit('dormManagement') || vnCanEdit('closedCases');
    }
    match /vietnam_dormitoryUtilities/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('dormManagement');
    }
    // 行政未完成事項：自由新增的代辦事項清單，不綁定其他集合。
    match /vietnam_adminTodos/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('adminPending');
    }
    match /vietnam_meetings/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('meetings');
    }
    // 客戶名稱越南文對照表：元凱系統那幾個唯讀同步頁面的客戶分組標題要用，
    // read 也放行 tsIsMember()，方便境外生實習系統那邊將來如果也要用同一套
    // 對照表時不用再改規則。
    match /vietnam_companyNameTranslations/{docId} {
      allow read: if vnIsMember() || tsIsMember();
      allow write: if vnCanEdit('companyNameTranslations');
    }
    // 學校費用設定：學校代表＋獎金月費率（給內部獎金計算用）、獎學金金額
    // （給獎學金紀錄新增時自動帶入）。
    match /vietnam_schoolSetup/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('schoolSetup');
    }
    // 內部獎金設定：開發業務/行政主管/行政招募/行政簽證/外務人員全公司
    // 統一一筆固定月費率設定，供「內部獎金計算」試算。
    match /vietnam_internalBonusRateSetup/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('internalBonusRateSetup');
    }
    match /vietnam_scholarships/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('scholarships');
    }
    // 學生請款計算：每個學生每個月的已收款/收款日期記錄，其他金額欄位都是
    // 即時計算、不落地儲存。
    match /vietnam_studentBillingPayments/{docId} {
      allow read: if vnIsMember();
      allow write: if vnCanEdit('studentBilling');
    }
    // 公開線上履歷連結（/apply/vietnam?ref=...）不需要登入即可新增一筆履歷，
    // 只允許這裡列出的個人資料欄位＋assignedStaff/status/createdAt，且
    // status 一定要是「待處理」，studentId/processedAt（轉入學生資料後才會
    // 有）不開放公開連結寫入，避免公開連結被用來改到已轉入的狀態。
    function isPublicResumeSubmission() {
      return request.resource.data.keys().hasOnly([
        'originalName', 'chineseName', 'vietnameseName', 'hasPassport', 'passportId', 'gender', 'birthDate', 'nationality',
        'height', 'weight', 'school', 'enrollDate', 'programYears', 'department', 'expectedGraduation',
        'hasCert', 'certType', 'certLevel', 'certPickupDate', 'expectedExamDate', 'personalExperience',
        'photoUrl', 'passportPhotoUrl', 'assignedStaff', 'status', 'createdAt'
      ]) && (request.resource.data.originalName is string && request.resource.data.originalName.size() > 0)
        && request.resource.data.status == '待處理';
    }
    // 履歷表連結：學生透過公開連結送出的履歷，待內部人員審核後轉入
    // vietnam_students；轉入後的 studentId/processedAt 只能由內部人員寫入。
    match /vietnam_resumeSubmissions/{docId} {
      allow read: if vnIsMember();
      allow create: if vnCanEdit('resumeLinks') || isPublicResumeSubmission();
      allow update: if vnCanEdit('resumeLinks') || vnCanEdit('students');
      allow delete: if vnCanEdit('resumeLinks');
    }

    // ---------------- 食品工廠管理系統 (foodfactory) ----------------
    function ffRole() {
      return get(/databases/$(database)/documents/foodfactory_users/$(request.auth.uid)).data.role;
    }
    function ffIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/foodfactory_users/$(request.auth.uid));
    }
    function ffDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'view','會計人員':'view'},
        'inventory': {'系統管理員':'view','廠長主管':'view','倉管人員':'edit','產線人員':'view','品管人員':'view','業務出貨人員':'view','會計人員':'view'},
        'production': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'edit','品管人員':'view','業務出貨人員':'view','會計人員':'view'},
        'shipping': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'edit','會計人員':'view'},
        'billing': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'edit','會計人員':'edit'},
        'qc': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'edit','業務出貨人員':'view','會計人員':'view'},
        'cost': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'view','會計人員':'edit'},
        'pettyCash': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'view','會計人員':'edit'},
        'incomeStatement': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'view','會計人員':'edit'},
        'history': {'系統管理員':'view','廠長主管':'view','倉管人員':'view','產線人員':'view','品管人員':'view','業務出貨人員':'view','會計人員':'view'},
        'users': {'系統管理員':'view','廠長主管':'none','倉管人員':'none','產線人員':'none','品管人員':'none','業務出貨人員':'none','會計人員':'none'},
      }[module][role];
    }
    function ffCanEdit(module) {
      return ffIsMember() && (
        ffRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/foodfactory_rolePermissions/$(module + '__' + ffRole()))
          ? get(/databases/$(database)/documents/foodfactory_rolePermissions/$(module + '__' + ffRole())).data.level == 'edit'
          : ffDefaultLevel(module, ffRole()) == 'edit')
      );
    }

    match /foodfactory_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || ffIsMember());
      allow write: if ffIsMember() && ffRole() == '系統管理員';
    }
    match /foodfactory_rolePermissions/{docId} {
      allow read: if ffIsMember();
      allow write: if ffIsMember() && ffRole() == '系統管理員';
    }
    // 原料與庫存 group — 零用金對帳（支出且類別連動原料庫存）也會自動建原料/
    // 供應商/進貨/入庫紀錄，所以 create 額外放行 'pettyCash' 編輯者。
    match /foodfactory_materials/{docId} {
      allow read: if ffIsMember();
      allow create: if ffCanEdit('inventory') || ffCanEdit('pettyCash');
      allow update, delete: if ffCanEdit('inventory');
    }
    match /foodfactory_suppliers/{docId} {
      allow read: if ffIsMember();
      allow create: if ffCanEdit('inventory') || ffCanEdit('pettyCash');
      allow update, delete: if ffCanEdit('inventory');
    }
    match /foodfactory_purchases/{docId} {
      allow read: if ffIsMember();
      allow create: if ffCanEdit('inventory') || ffCanEdit('pettyCash');
      allow update, delete: if ffCanEdit('inventory');
    }
    // 進貨單新增、生產用料、零用金支出都會各自同步寫一筆庫存異動紀錄。
    match /foodfactory_inventoryLogs/{docId} {
      allow read: if ffIsMember();
      allow create: if ffCanEdit('inventory') || ffCanEdit('production') || ffCanEdit('pettyCash');
      allow update, delete: if ffCanEdit('inventory');
    }
    // 原料主檔每次新增/編輯/刪除都會同步寫一筆修改紀錄，唯讀、只能新增不能改/刪。
    match /foodfactory_materialChangeLogs/{docId} {
      allow read: if ffIsMember();
      allow create: if ffCanEdit('inventory') || ffCanEdit('pettyCash');
    }
    // 共用修改紀錄 — 其餘各頁面（供應商/進貨單/成品/客戶/出貨單/生產批次/
    // 品質/成本/零用金/損益表/合夥分潤/客戶請款）新增/編輯/刪除時都寫一筆到
    // 這裡，用 entity 欄位區分來源。唯讀、只能新增不能改/刪。
    match /foodfactory_changeLogs/{docId} {
      allow read: if ffIsMember();
      allow create: if ffIsMember();
    }

    // 生產管理 group — 成本分析頁面登錄生產費用，所以 create 額外放行 'cost'。
    match /foodfactory_productionBatches/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('production');
    }
    match /foodfactory_productionMaterialUsage/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('production');
    }
    match /foodfactory_productionExpenses/{docId} {
      allow read: if ffIsMember();
      allow create: if ffCanEdit('production') || ffCanEdit('cost');
      allow update, delete: if ffCanEdit('production') || ffCanEdit('cost');
    }

    // 成品與出貨 group
    match /foodfactory_products/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('shipping');
    }
    // 生產批次「完成入庫」寫入這裡，出貨單扣庫存也寫這裡 — 兩個權限模組都能寫。
    match /foodfactory_productInventory/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('shipping') || ffCanEdit('production');
    }
    match /foodfactory_customers/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('shipping');
    }
    // 客戶請款明細建立請款單時會把出貨單標上 invoiceId，所以 update 額外放行 'billing'。
    match /foodfactory_shipments/{docId} {
      allow read: if ffIsMember();
      allow create, delete: if ffCanEdit('shipping');
      allow update: if ffCanEdit('shipping') || ffCanEdit('billing');
    }

    // 品質/食安 group
    match /foodfactory_qcTemplates/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('qc');
    }
    match /foodfactory_qcTemplateItems/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('qc');
    }
    match /foodfactory_qcRecords/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('qc');
    }
    match /foodfactory_qcRecordItems/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('qc');
    }

    // 零用金對帳
    match /foodfactory_pettyCashTransactions/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('pettyCash');
    }
    match /foodfactory_expenseCategories/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('pettyCash');
    }

    // 損益表 group
    match /foodfactory_accountCategories/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('incomeStatement');
    }
    match /foodfactory_manualLedgerEntries/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('incomeStatement');
    }
    match /foodfactory_partners/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('incomeStatement');
    }
    match /foodfactory_profitPayouts/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('incomeStatement');
    }

    // 客戶請款明細
    match /foodfactory_customerInvoices/{docId} {
      allow read: if ffIsMember();
      allow write: if ffCanEdit('billing');
    }

    // ---------------- 派遣公司專用系統 (dispatch) ----------------
    function dpRole() {
      return get(/databases/$(database)/documents/dispatch_users/$(request.auth.uid)).data.role;
    }
    function dpIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/dispatch_users/$(request.auth.uid));
    }
    function dpDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'view','會計人員':'view'},
        'jobSeekers': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit','會計人員':'view'},
        'interviews': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view','會計人員':'none'},
        'employmentStatus': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'edit','會計人員':'view'},
        'managerReport': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'none','會計人員':'none'},
        'meetings': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view','會計人員':'view'},
        'applicationForms': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit','會計人員':'edit'},
        'bonus': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'none','會計人員':'edit'},
        'users': {'系統管理員':'edit','主管':'view','業務人員':'none','行政人員':'none','會計人員':'none'},
      }[module][role];
    }
    function dpCanEdit(module) {
      return dpIsMember() && (
        dpRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/dispatch_rolePermissions/$(module + '__' + dpRole()))
          ? get(/databases/$(database)/documents/dispatch_rolePermissions/$(module + '__' + dpRole())).data.level == 'edit'
          : dpDefaultLevel(module, dpRole()) == 'edit')
      );
    }

    match /dispatch_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || dpIsMember());
      allow write: if dpIsMember() && dpRole() == '系統管理員';
    }
    match /dispatch_rolePermissions/{docId} {
      allow read: if dpIsMember();
      allow write: if dpIsMember() && dpRole() == '系統管理員';
    }
    // 公開線上履歷連結（/apply/dispatch?ref=...）不需要登入即可新增一筆求職
    // 者資料，只允許這裡列出的個人資料欄位＋recruiter/status/createdAt，且
    // status 一定要是「求職中」，避免公開連結被用來塞入其他欄位（黑名單、
    // 薪資、狀態等）或改到既有資料。
    function isPublicJobSeekerApply() {
      return request.resource.data.keys().hasOnly([
        'chineseName', 'idNumber', 'birthDate', 'age', 'gender', 'mobile', 'phone', 'address',
        'licensePlate', 'education', 'emergencyContact', 'emergencyContactPhone', 'notes',
        'bankCode', 'bankName', 'bankBranchCode', 'bankBranchName', 'bankAccountName', 'bankAccount',
        'transferFee', 'recruiter', 'status', 'createdAt'
      ]) && request.resource.data.chineseName is string && request.resource.data.chineseName.size() > 0
        && request.resource.data.status == '求職中';
    }
    match /dispatch_jobSeekers/{docId} {
      allow read: if dpIsMember();
      allow create: if dpCanEdit('jobSeekers') || isPublicJobSeekerApply();
      allow delete: if dpCanEdit('jobSeekers');
      allow update: if dpCanEdit('jobSeekers');
    }
    // 面試概況：新增求職者自動建立一筆待安排的面試紀錄，所以 create 也開放
    // 給能編輯 jobSeekers 的角色；刪除求職者會連動刪除面試紀錄。
    match /dispatch_interviews/{docId} {
      allow read: if dpIsMember();
      allow create: if dpCanEdit('interviews') || dpCanEdit('jobSeekers');
      allow update: if dpCanEdit('interviews');
      allow delete: if dpCanEdit('interviews') || dpCanEdit('jobSeekers');
    }
    // 在職/離職概況：面試進度變成「報到」時自動建立在職紀錄，所以 create 也
    // 開放給能編輯 interviews 的角色；刪除求職者會連動刪除在職紀錄；薪資異動
    // 核准後會把新薪資寫回底薪欄位，所以 update 也開放給 applicationForms。
    match /dispatch_employmentStatus/{docId} {
      allow read: if dpIsMember();
      allow create: if dpCanEdit('employmentStatus') || dpCanEdit('interviews') || dpCanEdit('jobSeekers');
      allow update: if dpCanEdit('employmentStatus') || dpCanEdit('applicationForms');
      allow delete: if dpCanEdit('employmentStatus') || dpCanEdit('jobSeekers');
    }
    match /dispatch_meetings/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('meetings');
    }
    match /dispatch_dailyExpenseApplications/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('applicationForms');
    }
    match /dispatch_cashPaymentList/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('applicationForms');
    }
    match /dispatch_salaryChanges/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('applicationForms');
    }
    match /dispatch_clients/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('bonus');
    }
    match /dispatch_clientFeeSetup/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('bonus');
    }
    match /dispatch_referralBonusRate/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('bonus');
    }
    match /dispatch_internalFeeSetup/{docId} {
      allow read: if dpIsMember();
      allow write: if dpCanEdit('bonus');
    }

    // ---------------- 宿舍管理系統 (dormMgmt) ----------------
    function dmRole() {
      return get(/databases/$(database)/documents/dormMgmt_users/$(request.auth.uid)).data.role;
    }
    function dmIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/dormMgmt_users/$(request.auth.uid));
    }
    function dmDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'edit','主管':'edit','行政人員':'view','會計人員':'view'},
        'leases': {'系統管理員':'edit','主管':'edit','行政人員':'edit','會計人員':'view'},
        'remittance': {'系統管理員':'edit','主管':'edit','行政人員':'view','會計人員':'edit'},
        'users': {'系統管理員':'edit','主管':'view','行政人員':'none','會計人員':'none'},
      }[module][role];
    }
    function dmCanEdit(module) {
      return dmIsMember() && (
        dmRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/dormMgmt_rolePermissions/$(module + '__' + dmRole()))
          ? get(/databases/$(database)/documents/dormMgmt_rolePermissions/$(module + '__' + dmRole())).data.level == 'edit'
          : dmDefaultLevel(module, dmRole()) == 'edit')
      );
    }

    match /dormMgmt_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || dmIsMember());
      allow write: if dmIsMember() && dmRole() == '系統管理員';
    }
    match /dormMgmt_rolePermissions/{docId} {
      allow read: if dmIsMember();
      allow write: if dmIsMember() && dmRole() == '系統管理員';
    }
    match /dormMgmt_leases/{docId} {
      allow read: if dmIsMember();
      allow write: if dmCanEdit('leases');
    }

    // ---------------- 外勞仲介管理系統 (yujian) ----------------
    function yjRole() {
      return get(/databases/$(database)/documents/yujian_users/$(request.auth.uid)).data.role;
    }
    function yjIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/yujian_users/$(request.auth.uid));
    }
    function yjDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'view'},
        'workers': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'employers': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'matches': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'secondInterview': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'admitted': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'placementList': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'applicationProgress': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'edit'},
        'arrivedList': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'edit'},
        'arrivedSummary': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'edit'},
        'closedCases': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'meetings': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'dailyExpenseApplication': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'postageFee': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'users': {'系統管理員':'edit','主管':'view','業務人員':'none','行政人員':'none'},
      }[module][role];
    }
    function yjCanEdit(module) {
      return yjIsMember() && (
        yjRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/yujian_rolePermissions/$(module + '__' + yjRole()))
          ? get(/databases/$(database)/documents/yujian_rolePermissions/$(module + '__' + yjRole())).data.level == 'edit'
          : yjDefaultLevel(module, yjRole()) == 'edit')
      );
    }

    match /yujian_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || yjIsMember());
      allow write: if yjIsMember() && yjRole() == '系統管理員';
    }
    match /yujian_rolePermissions/{docId} {
      allow read: if yjIsMember();
      allow write: if yjIsMember() && yjRole() == '系統管理員';
    }
    // 已結案名單的「復原」按鈕會把 confirmedClosed 改回 false，所以 update 也
    // 放行 closedCases。
    match /yujian_workers/{docId} {
      allow read: if yjIsMember();
      allow create, delete: if yjCanEdit('workers');
      allow update: if yjCanEdit('workers') || yjCanEdit('closedCases');
    }
    match /yujian_employers/{docId} {
      allow read: if yjIsMember();
      allow create, delete: if yjCanEdit('employers');
      allow update: if yjCanEdit('employers') || yjCanEdit('closedCases');
    }
    // 新增看護/家事人員資料時會自動在這裡建立一筆媒合紀錄（雇主待指定），
    // 所以 create 也放行 workers。
    // 刪除看護/家事人員資料或雇主家庭/需求單時，會連動刪掉相關的媒合紀錄
    // （及媒合紀錄再往下連動的二面進度/錄取名單/申辦進度追蹤/已入台名單），
    // 所以 delete 也放行 workers、employers。
    match /yujian_matches/{docId} {
      allow read: if yjIsMember();
      allow create: if yjCanEdit('matches') || yjCanEdit('workers');
      allow update: if yjCanEdit('matches') || yjCanEdit('closedCases');
      allow delete: if yjCanEdit('matches') || yjCanEdit('workers') || yjCanEdit('employers');
    }
    // 人員狀態變「轉出中」時會自動在這裡建立一筆安置紀錄，所以 create 也
    // 放行 workers。
    // 申辦進度追蹤／已入台名單案件的進度狀態變「轉出中」時也會自動在這裡
    // 建立一筆安置紀錄，所以 create 也放行 applicationProgress、arrivedList。
    match /yujian_placementList/{docId} {
      allow read: if yjIsMember();
      allow create: if yjCanEdit('placementList') || yjCanEdit('workers') || yjCanEdit('applicationProgress') || yjCanEdit('arrivedList');
      allow update: if yjCanEdit('placementList');
      allow delete: if yjCanEdit('placementList') || yjCanEdit('workers');
    }
    // 媒合紀錄狀態變「已媒合」會自動建立二面進度，所以 create 也放行 matches。
    match /yujian_secondInterviews/{docId} {
      allow read: if yjIsMember();
      allow create: if yjCanEdit('secondInterview') || yjCanEdit('matches');
      allow update: if yjCanEdit('secondInterview') || yjCanEdit('closedCases');
      allow delete: if yjCanEdit('secondInterview') || yjCanEdit('workers') || yjCanEdit('employers');
    }
    // 二面進度「通過」、或媒合紀錄狀態變「已錄取」都會自動建立/更新錄取
    // 名單，所以 create 也放行 secondInterview、matches。
    match /yujian_admittedList/{docId} {
      allow read: if yjIsMember();
      allow create: if yjCanEdit('admitted') || yjCanEdit('secondInterview') || yjCanEdit('matches');
      allow update: if yjCanEdit('admitted') || yjCanEdit('closedCases');
      allow delete: if yjCanEdit('admitted') || yjCanEdit('workers') || yjCanEdit('employers');
    }
    // 錄取名單狀態變「確認錄取」、或媒合紀錄狀態變「已錄取」都會自動建立
    // 申辦進度追蹤紀錄，所以 create 也放行 admitted、matches。
    match /yujian_applicationProgress/{docId} {
      allow read: if yjIsMember();
      allow create: if yjCanEdit('applicationProgress') || yjCanEdit('admitted') || yjCanEdit('matches');
      allow update: if yjCanEdit('applicationProgress') || yjCanEdit('closedCases');
      allow delete: if yjCanEdit('applicationProgress') || yjCanEdit('workers') || yjCanEdit('employers');
    }
    // 申辦進度追蹤案件的「入境時間」第一次填入日期時會自動帶入這裡，所以
    // create 也放行 applicationProgress。
    // 申辦進度追蹤的案件送工後每次存檔都會同步更新這裡對應的紀錄，所以
    // update 也放行 applicationProgress。
    match /yujian_arrivedList/{docId} {
      allow read: if yjIsMember();
      allow create: if yjCanEdit('arrivedList') || yjCanEdit('applicationProgress');
      allow update: if yjCanEdit('arrivedList') || yjCanEdit('applicationProgress') || yjCanEdit('closedCases');
      allow delete: if yjCanEdit('arrivedList') || yjCanEdit('applicationProgress') || yjCanEdit('workers') || yjCanEdit('employers');
    }
    match /yujian_meetings/{docId} {
      allow read: if yjIsMember();
      allow write: if yjCanEdit('meetings');
    }
    match /yujian_dailyExpenseApplications/{docId} {
      allow read: if yjIsMember();
      allow write: if yjCanEdit('dailyExpenseApplication');
    }
    match /yujian_postageFeeRecords/{docId} {
      allow read: if yjIsMember();
      allow write: if yjCanEdit('postageFee');
    }

    // ---------------- 元凱移工事業部 (laborAgency) ----------------
    // 獨立的越南外勞仲介引進系統，跟 yujian（看護/家事人員）分開，不共用
    // 任何集合。
    function laRole() {
      return get(/databases/$(database)/documents/laborAgency_users/$(request.auth.uid)).data.role;
    }
    function laIsMember() {
      return signedIn() && exists(/databases/$(database)/documents/laborAgency_users/$(request.auth.uid));
    }
    function laDefaultLevel(module, role) {
      return {
        'dashboard': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'view'},
        'workerRoster': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'workers': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'resumeLinks': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'employers': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'view'},
        'docsChecklist': {'系統管理員':'edit','主管':'edit','業務人員':'edit','行政人員':'edit'},
        'visaProcessing': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'edit'},
        'departure': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'edit'},
        'arrivalNotice': {'系統管理員':'edit','主管':'edit','業務人員':'view','行政人員':'edit'},
        'feeSetup': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'edit'},
        'chargeRecords': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'edit'},
        'paymentRecords': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'edit'},
        'bonus': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'view'},
        'bonusRateSetup': {'系統管理員':'edit','主管':'edit','業務人員':'none','行政人員':'none'},
        'users': {'系統管理員':'edit','主管':'view','業務人員':'none','行政人員':'none'},
      }[module][role];
    }
    function laCanEdit(module) {
      return laIsMember() && (
        laRole() == '系統管理員' ||
        (exists(/databases/$(database)/documents/laborAgency_rolePermissions/$(module + '__' + laRole()))
          ? get(/databases/$(database)/documents/laborAgency_rolePermissions/$(module + '__' + laRole())).data.level == 'edit'
          : laDefaultLevel(module, laRole()) == 'edit')
      );
    }

    match /laborAgency_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || laIsMember());
      allow write: if laIsMember() && laRole() == '系統管理員';
    }
    match /laborAgency_rolePermissions/{docId} {
      allow read: if laIsMember();
      allow write: if laIsMember() && laRole() == '系統管理員';
    }
    // 公開線上履歷連結（/apply/laborAgency）送出履歷時，會同時直接建立一筆
    // 工人資料（不用等內部人員「轉入移工管理」），只開放這裡列出的基本
    // 欄位＋固定的初始階段，不能是其他欄位（例如 employerId/passportExpiry
    // 等要內部人員才能填的資訊）。
    function isPublicLaborWorkerCreate() {
      return request.resource.data.keys().hasOnly([
        'name', 'vietnameseName', 'chineseName', 'gender', 'phone', 'province', 'photoUrl', 'note', 'stage', 'updatedAt',
        'hometown', 'hometownZh', 'birthDate', 'height', 'weight', 'eyesight', 'religion', 'religionZh',
        'ethnicity', 'ethnicityZh', 'dominantHand',
        'majorSurgery', 'hasTattoo', 'tattooPhotoUrl', 'lineQrPhotoUrl', 'maritalStatus', 'familyContactPhone',
        'fatherName', 'fatherAlive', 'fatherAge', 'fatherOccupation', 'fatherOccupationZh',
        'motherName', 'motherAlive', 'motherAge', 'motherOccupation', 'motherOccupationZh',
        'spouseName', 'spouseAge', 'spouseOccupation', 'spouseOccupationZh',
        'childrenCount', 'siblingsCount', 'birthOrder', 'relativesInTaiwan', 'relativesLocation',
        'educationLevel', 'educationLevelZh', 'chineseLevel', 'englishLevel',
        'domesticExperience', 'overseasExperience', 'specialties', 'specialtiesZh', 'interviewVideoLink'
      ]) && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.stage == '雇主確認';
    }
    // 文件追蹤頁面只會更新 docsChecked 欄位（勾選清單），所以 update 也
    // 放行 docsChecklist；履歷表連結轉入移工資料時也會新增一筆，所以
    // create 也放行 resumeLinks；移工名冊（跳過案件階段/雇主的簡化名冊）
    // 共用同一個集合，也放行 workerRoster。
    match /laborAgency_workers/{docId} {
      allow read: if laIsMember();
      allow create: if laCanEdit('workers') || laCanEdit('resumeLinks') || laCanEdit('workerRoster') || isPublicLaborWorkerCreate();
      allow delete: if laCanEdit('workers') || laCanEdit('workerRoster');
      allow update: if laCanEdit('workers') || laCanEdit('docsChecklist') || laCanEdit('workerRoster')
        || laCanEdit('visaProcessing') || laCanEdit('departure') || laCanEdit('arrivalNotice');
    }
    match /laborAgency_employers/{docId} {
      allow read: if laIsMember();
      allow write: if laCanEdit('employers');
    }
    match /laborAgency_feeSetup/{docId} {
      allow read: if laIsMember();
      allow write: if laCanEdit('feeSetup');
    }
    match /laborAgency_chargeRecords/{docId} {
      allow read: if laIsMember();
      allow write: if laCanEdit('chargeRecords');
    }
    match /laborAgency_paymentRecords/{docId} {
      allow read: if laIsMember();
      allow write: if laCanEdit('paymentRecords');
    }
    // 內部獎金編輯：全公司統一一筆設定（固定 doc id "default"），跟
    // dispatch_referralBonusRate 同一套做法，用 bonusRateSetup 這個權限鍵
    // 單獨控管（跟「內部獎金」頁面本身的 bonus 權限鍵分開，避免有唯讀
    // 權限看獎金試算的人也能改費率）。
    match /laborAgency_bonusRateSetup/{docId} {
      allow read: if laIsMember();
      allow write: if laCanEdit('bonusRateSetup');
    }
    // 公開線上履歷連結（/apply/laborAgency?ref=...）不需要登入即可新增一筆
    // 履歷，只允許這裡列出的欄位＋assignedStaff/status/createdAt，且 status
    // 一定要是「待處理」。workerId 開放在「建立當下」填入（送出履歷時會
    // 同時直接建立一筆工人資料，見 isPublicLaborWorkerCreate()），但
    // processedAt 仍不開放公開連結寫入；且這條規則只管 create，既有紀錄
    // 之後要改 workerId（例如內部人員事後手動轉入）一樣只能靠內部人員的
    // laCanEdit() 走 update。
    function isPublicLaborResumeSubmission() {
      return request.resource.data.keys().hasOnly([
        'vietnameseName', 'chineseName', 'gender', 'phone', 'hometown', 'hometownZh', 'birthDate', 'height', 'weight', 'eyesight',
        'religion', 'religionZh', 'ethnicity', 'ethnicityZh', 'dominantHand', 'majorSurgery', 'hasTattoo',
        'tattooPhotoUrl', 'lineQrPhotoUrl',
        'maritalStatus', 'familyContactPhone', 'photoUrl',
        'fatherName', 'fatherAlive', 'fatherAge', 'fatherOccupation', 'fatherOccupationZh',
        'motherName', 'motherAlive', 'motherAge', 'motherOccupation', 'motherOccupationZh',
        'spouseName', 'spouseAge', 'spouseOccupation', 'spouseOccupationZh',
        'childrenCount', 'siblingsCount', 'birthOrder', 'relativesInTaiwan', 'relativesLocation',
        'educationLevel', 'educationLevelZh', 'chineseLevel', 'englishLevel',
        'domesticExperience', 'overseasExperience', 'specialties', 'specialtiesZh', 'interviewVideoLink',
        'assignedStaff', 'status', 'createdAt', 'workerId'
      ]) && (request.resource.data.vietnameseName is string && request.resource.data.vietnameseName.size() > 0)
        && request.resource.data.status == '待處理';
    }
    // 履歷表連結：移工透過公開連結送出的履歷，待內部人員審核後轉入
    // laborAgency_workers；轉入後的 workerId/processedAt 只能由內部人員寫入。
    match /laborAgency_resumeSubmissions/{docId} {
      allow read: if laIsMember();
      allow create: if laCanEdit('resumeLinks') || isPublicLaborResumeSubmission();
      allow update: if laCanEdit('resumeLinks') || laCanEdit('workers');
      allow delete: if laCanEdit('resumeLinks');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
